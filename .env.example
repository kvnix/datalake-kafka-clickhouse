# Copie para .env e ajuste se precisar:  cp .env.example .env
# ATENÇÃO: credenciais de LABORATÓRIO, apenas para uso local. Não reutilize em outros ambientes.

# --- Postgres ("produção") ---
POSTGRES_DB=northwind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432

# --- Kafka ---
KAFKA_PORT=9092
TOPIC_PREFIX=northwind

# --- Kafka Connect / Debezium ---
CONNECT_PORT=8083

# --- ClickHouse ---
# Portas fora do padrão (8123/9000) para não conflitar com outro ClickHouse local.
CLICKHOUSE_USER=lab
CLICKHOUSE_PASSWORD=lab
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000

# --- Kafka UI ---
KAFKA_UI_PORT=8080

# --- Gerador de tráfego ---
TRAFFIC_ENABLED=true
TRAFFIC_TICK_SECONDS=5
TRAFFIC_MAX_ORDER_ID=32000
# Pesos relativos das ações
TRAFFIC_WEIGHT_NEW_ORDER=30
TRAFFIC_WEIGHT_SHIP_ORDER=25
TRAFFIC_WEIGHT_STOCK=20
TRAFFIC_WEIGHT_PRICE=10
TRAFFIC_WEIGHT_CANCEL_ORDER=10
TRAFFIC_WEIGHT_NEW_CUSTOMER=5
